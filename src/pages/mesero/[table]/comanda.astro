---
import AppLayout from "../../../layouts/AppLayout.astro";
import PageShell from "../../../components/astro/PageShell.astro";
import TableBand from "../../../components/astro/TableBand.astro";
import OrderComposer from "../../../components/islands/OrderComposer.tsx";
import { tablePaths } from "../../../lib/paths";

export const getStaticPaths = tablePaths;
const table = Number(Astro.params.table);
---

<AppLayout title={`Mesa ${String(table).padStart(2, "0")} · Comanda`} role="waiter">
  <PageShell back={{ href: `/mesero/${table}`, label: "Menú" }} step={3} table={table} width="wide">
    <TableBand table={table} eyebrow="Revisa antes de enviar" />
    <OrderComposer client:only="react" table={table}>
      <div slot="fallback" class="skeleton h-[32rem] max-w-3xl" aria-hidden="true"></div>
    </OrderComposer>
  </PageShell>
</AppLayout>
