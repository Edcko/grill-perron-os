---
import AppLayout from "../../../layouts/AppLayout.astro";
import PageShell from "../../../components/astro/PageShell.astro";
import TableBand from "../../../components/astro/TableBand.astro";
import OrderTracking from "../../../components/islands/OrderTracking.tsx";
import { tablePaths } from "../../../lib/paths";

export const getStaticPaths = tablePaths;
const table = Number(Astro.params.table);
const label = `Mesa ${String(table).padStart(2, "0")}`;
---

<AppLayout title={`${label} · Seguimiento del pedido`} role="waiter">
  <PageShell back={{ href: "/mesero", label: "Mesas" }} step={4} table={table}>
    <TableBand table={table} eyebrow={label} title="Seguimiento del pedido" />
    <OrderTracking client:only="react" table={table}>
      <div slot="fallback" class="skeleton h-[28rem]" aria-hidden="true"></div>
    </OrderTracking>
  </PageShell>
</AppLayout>
