---
import { Image } from "astro:assets";
import AppLayout from "../layouts/AppLayout.astro";
import Logo from "../components/astro/Logo.astro";
import UserSelector from "../components/islands/UserSelector.tsx";
import heroTacos from "../assets/food/hero-tacos.jpg";
---

<AppLayout title="Iniciar turno · Grill Perrón">
  <div class="min-h-dvh grid lg:grid-cols-[1fr_1.05fr]">
    <aside class="relative overflow-hidden bg-ink text-white min-h-[11rem] lg:h-dvh lg:sticky lg:top-0 on-dark">
      <Image
        src={heroTacos}
        alt="Tacos de birria recién servidos con cebolla, cilantro y limón"
        widths={[640, 1100]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="absolute inset-0 size-full object-cover opacity-70"
        loading="eager"
        fetchpriority="high"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/10" aria-hidden="true"></div>
      <div class="relative h-full flex flex-col justify-between p-6 lg:p-10 gap-4 lg:gap-10">
        <a href="/" class="press self-start rounded-lg" aria-label="Volver al inicio"><Logo size="md" tone="white" /></a>
        <div>
          <p class="eyebrow text-white/70">Turno noche · Salón y terraza</p>
          <p class="display text-[2.4rem] lg:text-[4rem] mt-2 lg:max-w-[11ch]">Buenas noches, equipo.</p>
          <p class="mt-3 text-white/75 max-w-sm hidden lg:block">12 mesas · 3 estaciones en cocina · Comandas sincronizadas en tiempo real.</p>
        </div>
      </div>
    </aside>

    <main class="flex items-center justify-center px-4 sm:px-10 py-8">
      <div class="w-full max-w-[34rem]" transition:name="login-panel">
        <p class="eyebrow text-brand">Grill Perrón OS</p>
        <h1 class="display text-[2.8rem] sm:text-[3.4rem] mt-1 mb-6">Selecciona tu usuario</h1>
        <UserSelector client:load />
      </div>
    </main>
  </div>
</AppLayout>
