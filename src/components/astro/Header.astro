---
import { ChevronLeft, Wifi } from "lucide-react";
import Logo from "./Logo.astro";

interface Props {
  back?: { href: string; label: string };
  /** Position in the table flow, when inside a table. */
  step?: 1 | 2 | 3 | 4;
  table?: number;
}

const { back, step, table } = Astro.props;
const steps = ["Mesa", "Menú", "Comanda", "Seguimiento"];
---

<header class="sticky top-0 z-30 bg-surface border-b border-line" transition:name="app-header">
  <div class="mx-auto max-w-[1400px] h-[4.25rem] px-4 sm:px-6 flex items-center gap-3">
    {
      back ? (
        <a
          href={back.href}
          class="press -ml-2 inline-flex items-center gap-1 h-12 pl-2 pr-3 rounded-xl font-semibold text-[0.95rem] hover:bg-ink/5"
        >
          <ChevronLeft size={22} aria-hidden="true" />
          <span>{back.label}</span>
        </a>
      ) : (
        <a href="/" class="press rounded-lg" aria-label="Grill Perrón, inicio">
          <Logo size="sm" />
        </a>
      )
    }

    {
      step && (
        <ol class="hidden xl:flex items-center gap-1.5 ml-3 text-[0.8rem] font-semibold whitespace-nowrap" aria-label="Pasos del pedido">
          {steps.map((label, i) => (
            <li class="flex items-center gap-1.5">
              <span
                class:list={[
                  "inline-flex items-center gap-1.5 h-8 px-3 rounded-full",
                  i + 1 === step ? "bg-ink text-white" : i + 1 < step ? "text-ink" : "text-muted",
                ]}
                aria-current={i + 1 === step ? "step" : undefined}
              >
                <span class="font-mono text-[0.7rem] opacity-70">{i + 1}</span>
                {i === 0 && table ? `Mesa ${String(table).padStart(2, "0")}` : label}
              </span>
              {i < steps.length - 1 && <span class="w-4 h-px bg-ink/20" aria-hidden="true" />}
            </li>
          ))}
        </ol>
      )
    }

    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <span
        data-connection
        class="hidden sm:inline-flex items-center gap-1.5 h-9 px-3 rounded-full bg-white border border-line text-[0.78rem] font-semibold"
      >
        <span class="relative flex size-2">
          <span data-connection-dot class="absolute inset-0 rounded-full bg-ready-bright"></span>
        </span>
        <Wifi size={14} aria-hidden="true" />
        <span data-connection-label>En vivo</span>
      </span>
      <time data-clock class="font-mono text-[0.95rem] font-bold tabular-nums w-[3.2rem] text-right">--:--</time>
      <a
        href="/inicio"
        data-user
        class="press flex items-center gap-2 h-11 pl-1.5 pr-3 rounded-full bg-white border border-line"
        aria-label="Cambiar de usuario"
      >
        <span data-user-initials class="grid place-items-center size-8 rounded-full bg-ink text-white text-[0.72rem] font-bold">MI</span>
        <span class="hidden sm:flex flex-col leading-tight text-left">
          <span data-user-name class="text-[0.85rem] font-bold">Misael</span>
          <span class="text-[0.68rem] text-muted font-medium">En turno</span>
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  import { bindChrome } from "../../lib/chrome";
  document.addEventListener("astro:page-load", bindChrome);
</script>
